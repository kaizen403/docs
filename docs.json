{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenLinear",
  "colors": {
    "primary": "#6366f1",
    "light": "#818cf8",
    "dark": "#4f46e5"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Features",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "features/getting-started"
            ]
          },
          {
            "group": "Core",
            "pages": [
              "features/kanban-board",
              "features/task-management",
              "features/task-execution",
              "features/batch-execution"
            ]
          },
          {
            "group": "AI Tools",
            "pages": [
              "features/brainstorm",
              "features/god-mode"
            ]
          },
          {
            "group": "Workspace",
            "pages": [
              "features/projects",
              "features/teams",
              "features/inbox",
              "features/settings"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "groups": [
          {
            "group": "Integrations",
            "pages": [
              "integrations/opencode",
              "integrations/mcp",
              "integrations/github"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/architecture",
              "reference/real-time-events",
              "reference/api"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/kaizen403/openlinear",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/kaizen403/openlinear"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get OpenLinear",
      "href": "https://openlinear.tech"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/kaizen403/openlinear"
    }
  }
}
